# Copy to server/.env (gitignored) and fill in Paysafe TEST credentials. Never commit real values.

# Public (single-use token) API key for Paysafe Checkout in the browser.
# Either "username:password" or the base64 of it.
PAYSAFE_PUBLIC_API_KEY=

# Private (server-to-server) API key for /paymenthub/v1/payments. Same format.
PAYSAFE_PRIVATE_API_KEY=

# VIP Preferred test consumer id (9 digits; a Paysafe TEST value, never a real SSN).
PAYSAFE_VIPP_CONSUMER_ID=

# Only needed if Paysafe configured more than one VIP Preferred account for USD.
PAYSAFE_VIPP_ACCOUNT_ID=

# Fake TEST patron sent as customer/billingAddress (VIP Preferred requires billing details).
# Defaults live in server.py; uncomment to override.
# PAYSAFE_TEST_FIRST_NAME=Test
# PAYSAFE_TEST_LAST_NAME=Patron
# PAYSAFE_TEST_EMAIL=test.patron@example.com
# PAYSAFE_TEST_PHONE=2155550100
# PAYSAFE_TEST_DOB=1985-01-15
# PAYSAFE_TEST_STREET=100 Test Street
# PAYSAFE_TEST_CITY=Philadelphia
# PAYSAFE_TEST_STATE=PA
# PAYSAFE_TEST_ZIP=19103
# PAYSAFE_TEST_COUNTRY=US

PAYSAFE_ENVIRONMENT=TEST
# TEST simulator: EXTERNAL (default) routes VIP Preferred/Plaid to Pavilion's test system; INTERNAL is
# Paysafe's own simulator (Plaid fails, amount-based delays). Ignored unless ENVIRONMENT=TEST.
# PAYSAFE_SIMULATOR=EXTERNAL
PAYSAFE_API_BASE=https://api.test.paysafe.com
PAYSAFE_CURRENCY=USD
PORT=8080
